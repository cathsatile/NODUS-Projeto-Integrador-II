# ─── Banco de dados ────────────────────────────────────────────────────────────
# DB_PATH é opcional: o banco SQLite fica em backend/ se não for definido.
# Em produção o Electron define DB_PATH automaticamente para app.getPath('userData').
# DB_PATH=/caminho/absoluto/para/nodus.db

# ─── Segurança ─────────────────────────────────────────────────────────────────
# Troque por uma string longa e aleatória antes da banca/demo.
# Em produção o Electron inicia o servidor com este valor via process.env.
JWT_SECRET=troque_por_um_secret_longo_e_aleatorio

# ─── Rede ──────────────────────────────────────────────────────────────────────
PORT=3000
# Vazio = aceita qualquer origem (incluindo file:// do Electron).
# Em desenvolvimento web normal, coloque: http://localhost:4200
FRONTEND_ORIGIN=http://localhost:4200
